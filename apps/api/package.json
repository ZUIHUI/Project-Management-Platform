{
  "name": "project-management-api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx seed.ts",
    "db:seed:compiled": "node dist/seed.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/smoke.mjs",
    "test:contract": "node scripts/contract.mjs",
    "test:contract:gate": "node scripts/contract-gate.mjs",
    "test:architecture": "node scripts/architecture-gate.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:unit": "tsx --test scripts/issue-update.test.mjs",
    "test:db": "node scripts/db-test-suite.mjs",
    "test:db:guard": "node scripts/database-test-guard.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^9.39.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
